# FENE beadspring benchmark

units           lj
atom_style      bond
special_bonds   fene

read_data       data.chain

neighbor        0.4 bin
neigh_modify    every 1 delay 1

bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0

pair_style      lj/cut 1.12
pair_modify     shift yes
pair_coeff      1 1 1.0 1.0 1.12

fix             1 all nve
fix             2 all langevin 1.0 1.0 10.0 904297

thermo          500
timestep        0.012

dump            1 all custom position_frequency pos_vel_force_file.dump id type x y z vx vy vz fx fy fz

# dump            1 all custom position_frequency position_dump id type x y z
# dump            2 all custom velocity_frequency velocity_dump id type vx vy vz
# dump            3 all custom force_frequency force_dump id type fx fy fz            

run             50000
